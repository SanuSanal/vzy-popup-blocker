{
  "manifest_version": 3,
  "name": "VZY Popup Blocker",
  "version": "1.0.0",
  "description": "Removes role=\"presentation\" popup divs on vzy.com and vzy.one.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VZY Popup Blocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "*://vzy.com/*",
    "*://*.vzy.com/*",
    "*://vzy.one/*",
    "*://*.vzy.one/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "remove-popup": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Remove role=presentation popup"
    }
  }
}
